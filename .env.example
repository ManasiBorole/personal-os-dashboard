# Local overrides (optional) — copy to assets/env/development.env or use dart-define.
# The app loads assets/env/development.env by default (committed, safe for dev).

APP_ENV=dev

# Supabase credentials — leave empty for local/offline mode.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Firebase (optional — push notifications)
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
